# ========================================================
# ICT Scanner V2 - Production Environment Variables
# ========================================================

# --- Core Runtime ---
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=sqlite+aiosqlite:///data/trading_bot.db

# --- Security ---
# Secret key protecting the admin endpoints and settings API
ADMIN_API_KEY=change_me_to_a_long_random_string

# --- Telegram Bot Alerts (Required for Telegram alerts) ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_or_channel_id

# --- Market Data Providers ---
# Twelve Data for Forex (EUR/USD, GBP/USD), Indices, and Crypto
TWELVE_DATA_API_KEY=your_twelve_data_api_key
# Oanda v20 API for forex execution/streaming (optional)
OANDA_API_KEY=your_oanda_api_key
# Default CCXT exchange: binance, bybit, okx
CRYPTO_EXCHANGE=binance

# --- AI Engine (Multi-LLM Setup Verification) ---
# Supported providers: gemini, openai, anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_MODEL=gemini-1.5-pro
MIN_PROBABILITY_THRESHOLD=75

# --- ICT Strategy Engine Parameters ---
MIN_RR=2.0
MSS_LOOKBACK_CANDLES=10
DISPLACEMENT_ATR_MULTIPLIER=1.5
SCAN_INTERVAL_SECONDS=300
TWELVE_DATA_POLL_INTERVAL_SECONDS=60

# --- Frontend Control Room Configuration ---
# Optional: Set when frontend connects to backend WebSocket over public domain/proxy
# NEXT_PUBLIC_API_WS_URL=wss://your-deployment-domain.botkeep.cloud/api/ws/dashboard

# --- Email Notifications (Optional SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_RECIPIENT_EMAIL=your_email@gmail.com
